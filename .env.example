# Supabase project settings (Dashboard -> Project Settings -> API)
# Both values are public by design: they end up in the browser bundle.
# Access control is enforced by Row Level Security in the database.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Never put the service_role / secret key here. It bypasses RLS and is only
# used by Edge Functions, where Supabase provides it automatically.
